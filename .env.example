# Infrastructure Credentials Template
# Copy this file to .env and replace with your actual credentials

# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=your_database_name

# MongoDB
MONGO_INITDB_ROOT_USERNAME=your_mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password

# Redis
REDIS_PASSWORD=your_secure_redis_password
