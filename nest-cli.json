{
  "monorepo": true,
  "root": "apps/eventflow",
  "sourceRoot": "apps/eventflow/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/eventflow/tsconfig.app.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "booking-service": {
      "type": "application",
      "root": "apps/booking-service",
      "entryFile": "main",
      "sourceRoot": "apps/booking-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/booking-service/tsconfig.app.json"
      }
    },
    "eventflow": {
      "type": "application",
      "root": "apps/eventflow",
      "entryFile": "main",
      "sourceRoot": "apps/eventflow/src",
      "compilerOptions": {
        "tsConfigPath": "apps/eventflow/tsconfig.app.json"
      }
    }
  }
}